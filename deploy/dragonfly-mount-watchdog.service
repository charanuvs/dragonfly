[Unit]
Description=Dragonfly recordings-drive mount watchdog (clears dead mounts)
Documentation=https://github.com/charanuvs/dragonfly

[Service]
Type=oneshot
# Root: umount/mount require privileges. This is why the check lives here
# rather than inside dragonfly-capture, which runs unprivileged as dragonfly.
User=root
ExecStart=/usr/local/sbin/dragonfly-mount-repair
