[Unit]
Description=Dragonfly camera detection and person alerts
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@INSTALL_DIR@
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-@CONFIG_DIR@/alerts.env
ExecStart=@VENV_DIR@/bin/dfly-detect
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target