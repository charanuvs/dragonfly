[Unit]
Description=Dragonfly capture service (heartbeat, recorder, live-stream ffmpeg)
After=network-online.target mosquitto.service mnt-dragonfly\x2dhdd.mount
Wants=network-online.target
# RequiresMountsFor (not BindsTo) only gates *startup* — it won't start
# capture until the drive is mounted, but deliberately does NOT tear the
# whole process down if the drive is later unplugged while running. That's
# intentional: heartbeat and live view don't touch this drive at all, so
# there's no reason to take the camera offline in the dashboard just
# because the recordings drive briefly disappeared. Only the recorder
# itself is affected — see recorder.py, which catches storage-write
# failures internally, publishes "not recording", and keeps retrying each
# scheduled segment attempt without needing capture (or this service) to
# restart at all. (An earlier version of this file used BindsTo= to tear
# the whole service down instead — reverted because it also killed
# heartbeat/live view, and because Restart= doesn't even auto-recover from
# a BindsTo-triggered stop; see git history / docs/recording.md.)
RequiresMountsFor=/mnt/dragonfly-hdd

[Service]
Type=simple
User=charan
WorkingDirectory=/home/charan/dragonfly
ExecStart=/home/charan/dragonfly/.venv/bin/dragonfly-capture
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
