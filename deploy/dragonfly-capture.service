[Unit]
Description=Dragonfly capture service (heartbeat, recorder, live-stream ffmpeg)
After=network-online.target mosquitto.service mnt-dragonfly\x2dhdd.mount
Wants=network-online.target
# Refuse to start until the recordings drive is actually mounted here — this
# only has an effect if /mnt/dragonfly-hdd has a real fstab entry (see
# docs/recording.md); systemd derives the mnt-dragonfly\x2dhdd.mount unit
# above from that entry automatically.
RequiresMountsFor=/mnt/dragonfly-hdd

[Service]
Type=simple
User=charan
WorkingDirectory=/home/charan/dragonfly
ExecStart=/home/charan/dragonfly/.venv/bin/dragonfly-capture
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
