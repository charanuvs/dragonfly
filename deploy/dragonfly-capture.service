[Unit]
Description=Dragonfly capture service (heartbeat, recorder, live-stream ffmpeg)
# After= only (no RequiresMountsFor/BindsTo): this is deliberately NOT tied
# to the drive's mount unit at all, in either direction. Two earlier
# attempts got this wrong:
#   1. BindsTo=mnt-dragonfly\x2dhdd.mount tore the whole service down when
#      the drive was unplugged, taking heartbeat/live view with it as
#      collateral damage even though neither touches that drive.
#   2. RequiresMountsFor=/mnt/dragonfly-hdd was assumed to only gate
#      *startup*, but confirmed on real hardware that it ALSO stops the
#      running service once the mount unit later goes away — same problem
#      as BindsTo, just less obviously.
# So capture no longer has any systemd-level dependency on the mount being
# present, at startup or afterward. Instead, recorder.py checks
# os.path.ismount() itself before every write (since mkdir() alone would
# silently write to the wrong place — the underlying root filesystem —
# rather than fail, if the drive isn't actually mounted), reports "not
# recording" over MQTT, and retries on schedule. See docs/recording.md.
After=network-online.target mosquitto.service mnt-dragonfly\x2dhdd.mount
Wants=network-online.target

[Service]
Type=simple
User=charan
WorkingDirectory=/home/charan/dragonfly
ExecStart=/home/charan/dragonfly/.venv/bin/dragonfly-capture
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
