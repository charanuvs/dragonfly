[Unit]
Description=Dragonfly capture service (heartbeat, recorder, live-stream ffmpeg)
After=network-online.target mosquitto.service mnt-dragonfly\x2dhdd.mount
Wants=network-online.target
# BindsTo (not just RequiresMountsFor) means this service is torn down
# whenever the drive's mount unit goes away — e.g. the USB drive gets
# unplugged mid-recording — instead of limping along with a dead recorder
# thread. NOTE: Restart=always below does NOT bring it back on its own —
# a BindsTo-triggered stop is a clean/intentional stop as far as systemd's
# Restart= logic is concerned, not a failure, so it won't retry (confirmed:
# `systemctl status` just sits at inactive/dead indefinitely after this).
# It's the udev rule in docs/recording.md that actually restarts this
# service, by explicitly `systemctl start`ing it the instant the drive is
# plugged back in and remounted. Restart=always is still useful here for a
# genuine crash of the capture process unrelated to the drive.
BindsTo=mnt-dragonfly\x2dhdd.mount
After=mnt-dragonfly\x2dhdd.mount

[Service]
Type=simple
User=charan
WorkingDirectory=/home/charan/dragonfly
ExecStart=/home/charan/dragonfly/.venv/bin/dragonfly-capture
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
