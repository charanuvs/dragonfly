[Unit]
Description=Dragonfly hub service
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/dragonfly
ExecStart=/home/pi/dragonfly/.venv/bin/dragonfly-hub
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
