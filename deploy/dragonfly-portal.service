[Unit]
Description=Dragonfly portal service (web dashboard)
After=network-online.target mosquitto.service
Wants=network-online.target
# No dependency on the recordings mount at all — the dashboard should come
# up and show "disk not mounted" rather than refuse to start, and it
# doesn't itself write to the recordings drive. (dragonfly-capture also has
# no such dependency now — see its own comments for why.)

[Service]
Type=simple
User=dragonfly
Group=dragonfly
WorkingDirectory=/opt/dragonfly
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/dragonfly/venv/bin/dragonfly-portal
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
