{
    auto_https disable_redirects
}

http://phila.int {
    bind <hub-tailscale-ip>
    redir https://phila.int{uri} 308
}

http://video.phila.int {
    bind <hub-tailscale-ip>
    redir https://video.phila.int{uri} 308
}

https://phila.int {
    bind <hub-tailscale-ip>
    tls /etc/caddy/tls/phila-services-int.crt /etc/caddy/tls/phila-services.key
    reverse_proxy 127.0.0.1:8000
}

https://video.phila.int {
    bind <hub-tailscale-ip>
    tls /etc/caddy/tls/phila-services-int.crt /etc/caddy/tls/phila-services.key
    reverse_proxy 127.0.0.1:8096
}